# amalthea - i3
# binds are deliberately the same as the hyprland config on asahi: mod is ALT,
# alt+return opens a terminal, alt+space opens the launcher, alt+w closes.
# anything that was a quickshell menu there is a rofi script here.

set $mod Mod1
set $dots $HOME/dotfiles

set $base    #16100f
set $surface #241a18
set $overlay #30231f
set $muted   #4a3832
set $dim     #a8928a
set $text    #f0e4de
set $ember   #c4745a
set $rust    #a85540

font pango:Iosevka Nerd Font 10

# look -----------------------------------------------------------------------

# hyprland counts 4px around each window (so 8 between two) and 8 at the edge.
# i3 counts the full gap between windows, and adds outer on top of inner/2,
# so inner 8 + outer 4 lands on the same numbers
gaps inner 8
gaps outer 4

default_border pixel 2
default_floating_border pixel 2
hide_edge_borders smart

#                       border    background  text    indicator  child_border
client.focused          $ember    $surface    $text   $ember     $ember
client.focused_inactive $muted    $surface    $dim    $muted     $muted
client.unfocused        $overlay  $base       $dim    $overlay   $overlay
client.urgent           $rust     $rust       $text   $rust      $rust
client.placeholder      $overlay  $base       $dim    $overlay   $overlay
client.background       $base

# input ----------------------------------------------------------------------

focus_follows_mouse yes
mouse_warping none
focus_on_window_activation smart
workspace_auto_back_and_forth no

# apps -----------------------------------------------------------------------

bindsym $mod+Return exec --no-startup-id alacritty

# menus (quickshell equivalents) ---------------------------------------------

bindsym $mod+space       exec --no-startup-id rofi -show drun
bindsym $mod+n           exec --no-startup-id $dots/scripts/wifi-menu.sh
bindsym $mod+v           exec --no-startup-id $dots/scripts/clipboard.sh
bindsym $mod+e           exec --no-startup-id rofimoji --action copy --skin-tone neutral
bindsym $mod+b           exec --no-startup-id $dots/scripts/bluetooth-menu.sh
bindsym $mod+p           exec --no-startup-id $dots/scripts/projects.sh
bindsym $mod+k           exec --no-startup-id $dots/scripts/kblayout.sh
bindsym $mod+Escape      exec --no-startup-id $dots/scripts/powermenu.sh
bindsym $mod+Shift+n     exec --no-startup-id $dots/scripts/tailnet.sh
bindsym $mod+Shift+b     exec --no-startup-id $dots/scripts/wallpaper.sh

# utils ----------------------------------------------------------------------

bindsym $mod+Shift+r     restart
bindsym $mod+Shift+l     exec --no-startup-id $dots/scripts/lock.sh
bindsym $mod+Shift+c     exec --no-startup-id $dots/scripts/colorpick.sh
bindsym $mod+c           exec --no-startup-id dunstctl close-all

# screenshot (macos numbering, same as asahi) --------------------------------

bindsym Ctrl+Shift+4     exec --no-startup-id $dots/scripts/screenshot.sh
bindsym Ctrl+Shift+3     exec --no-startup-id $dots/scripts/screenshot-full.sh

# session --------------------------------------------------------------------

bindsym $mod+Shift+o     exec --no-startup-id $dots/scripts/session.sh start
bindsym $mod+Shift+w     exec --no-startup-id $dots/scripts/session.sh close

# window management ----------------------------------------------------------

bindsym $mod+w kill
bindsym $mod+f fullscreen toggle
bindsym $mod+Shift+f floating toggle

bindsym $mod+Left  focus left
bindsym $mod+Down  focus down
bindsym $mod+Up    focus up
bindsym $mod+Right focus right

bindsym $mod+Shift+Left  move left
bindsym $mod+Shift+Down  move down
bindsym $mod+Shift+Up    move up
bindsym $mod+Shift+Right move right

# dwindle on asahi splits along the longer edge; this is the closest i3 has
bindsym $mod+s layout toggle split
bindsym $mod+t layout tabbed
bindsym $mod+Shift+s layout stacking

# hy3 tab cycling
bindsym Ctrl+Tab       focus next sibling
bindsym Ctrl+Shift+Tab focus prev sibling

# push the current workspace at the other output, like the asahi alt+tab
bindsym $mod+Tab   move workspace to output next
bindsym $mod+grave workspace back_and_forth

bindsym $mod+r mode resize
mode "resize" {
	bindsym Left  resize shrink width 4 px or 4 ppt
	bindsym Right resize grow width 4 px or 4 ppt
	bindsym Up    resize shrink height 4 px or 4 ppt
	bindsym Down  resize grow height 4 px or 4 ppt
	bindsym Return mode "default"
	bindsym Escape mode "default"
}

floating_modifier $mod
tiling_drag modifier titlebar

# workspaces -----------------------------------------------------------------

set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"

bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9

bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9

# window rules ---------------------------------------------------------------
# same workspace split as asahi: 1 terminal, 2 editor, 3 browser, 4 chat, 5 notes

assign [class="Alacritty"]  $ws1
assign [class="firefox"]    $ws3
assign [class="helium"]     $ws3

for_window [class="Zathura"] floating disable
for_window [window_role="pop-up"] floating enable, move position center
for_window [window_type="dialog"] floating enable, move position center
for_window [title="^(Open|Save) (File|Files|Folder)$"] floating enable, resize set 70ppt 75ppt, move position center
for_window [class="Blueman-manager"] floating enable, resize set 50ppt 60ppt, move position center
for_window [class="Pavucontrol"] floating enable, resize set 50ppt 60ppt, move position center

# fn keys --------------------------------------------------------------------

bindsym XF86AudioRaiseVolume  exec --no-startup-id $dots/scripts/volume.sh up
bindsym XF86AudioLowerVolume  exec --no-startup-id $dots/scripts/volume.sh down
bindsym XF86AudioMute         exec --no-startup-id $dots/scripts/volume.sh mute
bindsym XF86AudioMicMute      exec --no-startup-id $dots/scripts/volume.sh micmute
bindsym XF86MonBrightnessUp   exec --no-startup-id $dots/scripts/brightness.sh up
bindsym XF86MonBrightnessDown exec --no-startup-id $dots/scripts/brightness.sh down
bindsym XF86AudioPlay         exec --no-startup-id playerctl play-pause
bindsym XF86AudioPause        exec --no-startup-id playerctl play-pause
bindsym XF86AudioNext         exec --no-startup-id playerctl next
bindsym XF86AudioPrev         exec --no-startup-id playerctl previous

# the SL510 has a dedicated ThinkVantage key; nothing sensible owns it
bindsym XF86Launch1 exec --no-startup-id $dots/scripts/powermenu.sh

# autostart ------------------------------------------------------------------

exec_always --no-startup-id $dots/scripts/autostart.sh
