/* amalthea steel - rofi
 * one centred column, square corners, no icons, no mouse affordances - a
 * dmenu with a box around it. the asahi launcher is a single list you type
 * into and press enter; this is the same shape. */

* {
	base:     #0a0a0b;
	surface:  #16181b;
	overlay:  #202327;
	muted:    #3a3e44;
	dim:      #8b9097ff;
	text:     #e4e6e9ff;
	ember:    #6f94acff;
	amber:    #9fb0baff;

	background-color: transparent;
	text-color:       @text;
	margin:           0;
	padding:          0;
	spacing:          0;
}

window {
	location:         center;
	anchor:           center;
	width:            520px;
	border-radius:    0px;
	border:           1px;
	border-color:     @muted;
	background-color: @base;
	padding:          0;
}

mainbox {
	children: [ inputbar, listview ];
	padding:  10px;
	spacing:  8px;
}

inputbar {
	children:         [ prompt, entry ];
	background-color: @surface;
	border-radius:    0px;
	padding:          10px 12px;
	spacing:          10px;
}

prompt {
	text-color:       @ember;
	vertical-align:   0.5;
}

entry {
	placeholder:        "";
	placeholder-color:  @dim;
	vertical-align:     0.5;
	cursor:             text;
}

listview {
	lines:        8;
	columns:      1;
	fixed-height: false;
	scrollbar:    false;
	spacing:      2px;
	cycle:        true;
	dynamic:      true;
}

element {
	padding:       7px 12px;
	border-radius: 0px;
	spacing:       10px;
	cursor:        pointer;
}

element normal.normal   { background-color: transparent; text-color: @dim;   }
element alternate.normal{ background-color: transparent; text-color: @dim;   }
element selected.normal { background-color: @overlay;    text-color: @text;  }
element normal.urgent   { text-color: @amber; }
element selected.urgent { background-color: @overlay; text-color: @amber; }
element normal.active   { text-color: @ember; }
element selected.active { background-color: @overlay; text-color: @ember; }

element-text {
	vertical-align: 0.5;
	text-color:     inherit;
}

message {
	background-color: @surface;
	border-radius:    0px;
	padding:          10px 12px;
}

textbox {
	text-color: @dim;
}
