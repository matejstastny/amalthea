# amalthea - zathura

set font "Iosevka Nerd Font 10"
set selection-clipboard clipboard
set adjust-open "best-fit"
set guioptions ""
set statusbar-h-padding 8
set statusbar-v-padding 6
set page-padding 4
set scroll-step 80
set smooth-scroll true

set default-bg          "#0a0a0b"
set default-fg          "#e4e6e9"
set statusbar-bg        "#16181b"
set statusbar-fg        "#8b9097"
set inputbar-bg         "#16181b"
set inputbar-fg         "#e4e6e9"
set notification-bg     "#16181b"
set notification-fg     "#e4e6e9"
set notification-error-bg "#16181b"
set notification-error-fg "#b3555a"
set notification-warning-bg "#16181b"
set notification-warning-fg "#9fb0ba"
set highlight-color     "#9fb0ba"
set highlight-active-color "#6f94ac"
set completion-bg       "#16181b"
set completion-fg       "#8b9097"
set completion-highlight-bg "#202327"
set completion-highlight-fg "#e4e6e9"
set index-bg            "#0a0a0b"
set index-fg            "#e4e6e9"
set index-active-bg     "#202327"
set index-active-fg     "#e4e6e9"

# a white page next to a dark terminal is a flashbang; recolor instead
set recolor true
set recolor-keephue true
set recolor-darkcolor "#e4e6e9"
set recolor-lightcolor "#0a0a0b"
map r recolor
map <C-r> reload
